{
  "name": "demo-app-backend",
  "version": "1.0.0",
  "description": "Backend for web crawler",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "dev": "node ./build/server.js",
    "start": "tsc && npm run dev",
    "test": "jest --watchAll --verbose",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "node",
    "nodejs",
    "typescript",
    "orm",
    "mysql",
    "sequelize",
    "crud",
    "restapi",
    "rest",
    "api"
  ],
  "author": "bezkoder",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.4.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mysql2": "^3.4.3",
    "sequelize": "^6.32.1",
    "sequelize-typescript": "^2.1.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": [
      "**/__tests__/**/*.?(ts|js)?(x)",
      "**/?(*.)?(spec|test).?(ts|js)?(x)"
    ]
  }
}
